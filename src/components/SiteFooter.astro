---
import { appStoreURL, betaURL, repositoryURL } from "../data/site";
---

<footer class="site-footer">
  <nav class="site-footer__nav" aria-label="Footer">
    <a href="/">Home</a>
    <a href={appStoreURL}>App Store</a>
    <a href={betaURL}>Beta</a>
    <a href="/support">Support</a>
    <a href="/privacy">Privacy</a>
    <a href={repositoryURL}>GitHub</a>
  </nav>
  <p>Sealbreak · Open source · GPL-3.0</p>
  <p class="site-footer__legal">
    Apple, the Apple logo, and Face ID are trademarks of Apple Inc., registered
    in the U.S. and other countries. App Store is a service mark of Apple Inc.
    HashiCorp and Vault are trademarks of HashiCorp. OpenBao is a trademark of
    LF Projects, LLC. Sealbreak is an independent project and is not affiliated
    with, endorsed or sponsored by Apple, HashiCorp, the OpenBao project, LF
    Projects, LLC or The Linux Foundation.
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    width: min(calc(100% - 3rem), 74rem);
    margin: 0 auto;
    padding: 2.25rem 0 2.75rem;
    border-top: 1px solid rgb(150 184 214 / 0.18);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .site-footer a {
    color: var(--cream);
    font-size: 0.9rem;
    font-weight: 680;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--sun);
  }

  .site-footer a:focus-visible {
    border-radius: 0.3rem;
    outline: 3px solid var(--sun);
    outline-offset: 0.3rem;
  }

  .site-footer p {
    margin: 0;
    color: var(--secondary-text);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .site-footer .site-footer__legal {
    flex-basis: 100%;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.5;
    opacity: 0.8;
  }

  @media (max-width: 560px) {
    .site-footer {
      width: min(calc(100% - 2rem), 74rem);
    }
  }
</style>
