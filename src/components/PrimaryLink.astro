---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="primary-link" href={href}>
  <span><slot /></span>
</a>

<style>
  .primary-link {
    position: relative;
    display: inline-flex;
    min-height: 3.9rem;
    min-width: min(20rem, 100%);
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    border-radius: 1.35rem;
    background: var(--button);
    color: var(--cream);
    font-size: 1.05rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 0.6rem 1rem rgb(0 0 0 / 0.3);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
    isolation: isolate;
  }

  .primary-link::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--button-back);
    content: "";
    transform: translate(0.15rem, 0.38rem);
  }

  .primary-link:hover {
    transform: translateY(-0.12rem);
    box-shadow: 0 0.75rem 1.2rem rgb(0 0 0 / 0.34);
  }

  .primary-link:active {
    transform: translate(0.1rem, 0.2rem);
  }

  .primary-link:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: 0.45rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-link {
      transition: none;
    }
  }
</style>
