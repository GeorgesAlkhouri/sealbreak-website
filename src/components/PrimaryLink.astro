---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="primary-link" href={href}>
  <span><slot /></span>
</a>

<style>
  .primary-link {
    position: relative;
    display: inline-flex;
    min-height: 4.25rem;
    min-width: min(20rem, 100%);
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1rem;
    border-radius: 1.375rem;
    background: var(--button);
    color: var(--cream);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    box-shadow:
      0.125rem 0.375rem 0 var(--button-back),
      0 0.5625rem 1.125rem rgb(0 0 0 / 0.34);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .primary-link:hover {
    transform: translateY(-0.12rem);
    box-shadow:
      0.125rem 0.375rem 0 var(--button-back),
      0 0.6875rem 1.25rem rgb(0 0 0 / 0.36);
  }

  .primary-link:active {
    transform: translate(0.1rem, 0.2rem);
  }

  .primary-link:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: 0.45rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-link {
      transition: none;
    }
  }
</style>
