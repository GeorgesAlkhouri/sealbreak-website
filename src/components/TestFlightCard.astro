---
---

<a
  class="testflight-card"
  href="/beta"
  aria-label="Join the Sealbreak public beta on TestFlight"
>
  <span class="testflight-card__layer" aria-hidden="true"></span>

  <span class="testflight-card__front">
    <span class="testflight-card__content">
      <span class="testflight-card__icon" aria-hidden="true">
        <svg viewBox="0 0 49 58">
          <path
            d="M24.25 4L40.5 9.625V20.875C40.5 32.125 34.25 39.625 24.25 45.25C14.25 39.625 8 32.125 8 20.875V9.625L24.25 4ZM24.25 9.625L13 13.375V20.875C13 28.375 16.75 34 24.25 39C31.75 34 35.5 28.375 35.5 20.875V13.375L24.25 9.625Z"
            fill="currentColor"
          />
        </svg>
      </span>

      <span class="testflight-card__copy">
        <span class="testflight-card__title">Sealbreak Beta</span>
        <span class="testflight-card__subtitle">TestFlight</span>
      </span>

      <span class="testflight-card__status">
        Join Beta
        <span class="testflight-card__arrow" aria-hidden="true">→</span>
      </span>
    </span>
  </span>
</a>

<style>
  .testflight-card {
    position: relative;
    display: block;
    width: 100%;
    color: inherit;
    text-decoration: none;
    isolation: isolate;
  }

  .testflight-card__layer,
  .testflight-card__front {
    border-radius: 1.375rem;
  }

  .testflight-card__layer {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--card-back-1);
    transform: translate(0.22rem, 0.3rem);
    box-shadow: 0 0.45rem 0.75rem rgb(0 0 0 / 0.22);
    pointer-events: none;
  }

  .testflight-card__front {
    position: relative;
    display: block;
    background: var(--card);
    box-shadow: 0 0.45rem 0.85rem rgb(0 0 0 / 0.26);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .testflight-card__content {
    display: grid;
    min-height: 4.25rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.75rem 0.55rem 0.65rem;
  }

  .testflight-card__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 1rem;
    background: var(--forest-front);
    color: var(--cream);
    box-shadow:
      0.09rem 0.13rem 0 var(--sun),
      0 0.35rem 0.65rem rgb(0 0 0 / 0.24);
  }

  .testflight-card__icon svg {
    width: 1.65rem;
    height: auto;
  }

  .testflight-card__copy {
    display: grid;
    min-width: 0;
    gap: 0.18rem;
    text-align: left;
  }

  .testflight-card__title {
    overflow: hidden;
    color: var(--cream);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .testflight-card__subtitle {
    color: var(--secondary-text);
    font-size: 0.78rem;
    font-weight: 560;
    line-height: 1.2;
  }

  .testflight-card__status {
    display: inline-flex;
    min-height: 1.85rem;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--ring);
    color: var(--cream);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    box-shadow:
      0.1rem 0.14rem 0 var(--card-back-2),
      0 0.22rem 0.45rem rgb(0 0 0 / 0.2);
  }

  .testflight-card__arrow {
    color: var(--sun);
    transition: transform 140ms ease;
  }

  .testflight-card:hover .testflight-card__front {
    transform: translateY(-0.1rem);
    box-shadow: 0 0.55rem 1rem rgb(0 0 0 / 0.3);
  }

  .testflight-card:hover .testflight-card__arrow {
    transform: translateX(0.16rem);
  }

  .testflight-card:focus-visible {
    border-radius: 1.375rem;
    outline: 3px solid var(--sun);
    outline-offset: 0.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .testflight-card__front,
    .testflight-card__arrow {
      transition: none;
    }
  }
</style>
