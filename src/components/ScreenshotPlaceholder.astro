---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="screenshot-placeholder">
  <div class="screenshot-placeholder__paper" aria-hidden="true"></div>

  <div class="screenshot-placeholder__device">
    <img
      src={src}
      alt={alt}
      width="512"
      height="1108"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .screenshot-placeholder {
    position: relative;
    width: min(100%, 16.5rem);
    margin: 0 auto;
    isolation: isolate;
  }

  .screenshot-placeholder__paper {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 2.75rem;
    background: var(--card-back-1);
    transform: translate(0.55rem, 0.75rem) rotate(1.2deg);
    box-shadow: 0 0.8rem 1.4rem rgb(0 0 0 / 0.28);
  }

  .screenshot-placeholder__device {
    position: relative;
    aspect-ratio: 512 / 1108;
    overflow: hidden;
    border: 0.42rem solid var(--card);
    border-radius: 2.75rem;
    background: var(--forest-front);
    box-shadow:
      inset 0 0 0 0.08rem rgb(245 232 204 / 0.12),
      0 0.8rem 1.4rem rgb(0 0 0 / 0.32);
  }

  .screenshot-placeholder__device img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .screenshot-placeholder {
      width: min(100%, 16rem);
    }
  }
</style>
