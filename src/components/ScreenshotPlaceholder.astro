---
interface Props {
  step: string;
  label: string;
  variant?: "setup" | "sealed" | "result";
}

const {
  step,
  label,
  variant = "setup",
} = Astro.props;
---

<div
  class:list={[
    "screenshot-placeholder",
    `screenshot-placeholder--${variant}`,
  ]}
  role="img"
  aria-label={`${label} screenshot placeholder`}
>
  <div class="screenshot-placeholder__paper" aria-hidden="true"></div>

  <div class="screenshot-placeholder__device">
    <div class="screenshot-placeholder__island" aria-hidden="true"></div>

    <div class="screenshot-placeholder__screen" aria-hidden="true">
      <div class="screenshot-placeholder__topline">
        <span class="screenshot-placeholder__step">{step}</span>
        <span class="screenshot-placeholder__dot"></span>
      </div>

      <div class="screenshot-placeholder__mock">
        <span class="screenshot-placeholder__mock-line screenshot-placeholder__mock-line--short"></span>
        <span class="screenshot-placeholder__mock-line"></span>
        <span class="screenshot-placeholder__mock-line screenshot-placeholder__mock-line--medium"></span>

        <div class="screenshot-placeholder__mock-card">
          <span></span>
          <span></span>
        </div>

        <div class="screenshot-placeholder__mock-button"></div>
      </div>

      <span class="screenshot-placeholder__badge">Screenshot placeholder</span>
    </div>
  </div>
</div>

<style>
  .screenshot-placeholder {
    position: relative;
    width: min(100%, 16.5rem);
    margin: 0 auto;
    isolation: isolate;
  }

  .screenshot-placeholder__paper {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 2.75rem;
    background: var(--card-back-1);
    transform: translate(0.55rem, 0.75rem) rotate(1.2deg);
    box-shadow: 0 0.8rem 1.4rem rgb(0 0 0 / 0.28);
  }

  .screenshot-placeholder__device {
    position: relative;
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border: 0.42rem solid var(--card);
    border-radius: 2.75rem;
    background: var(--forest-front);
    box-shadow:
      inset 0 0 0 0.08rem rgb(245 232 204 / 0.12),
      0 0.8rem 1.4rem rgb(0 0 0 / 0.32);
  }

  .screenshot-placeholder__island {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 50%;
    width: 4.4rem;
    height: 1.25rem;
    border-radius: 999px;
    background: #020b12;
    transform: translateX(-50%);
  }

  .screenshot-placeholder__screen {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 3.1rem 1rem 1rem;
    background:
      radial-gradient(circle at 78% 13%, rgb(255 89 64 / 0.12), transparent 23%),
      var(--sky);
  }

  .screenshot-placeholder__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .screenshot-placeholder__step {
    color: var(--cream);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .screenshot-placeholder__dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 0.22rem rgb(255 89 64 / 0.13);
  }

  .screenshot-placeholder__mock {
    display: grid;
    gap: 0.55rem;
  }

  .screenshot-placeholder__mock-line {
    width: 100%;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--ring);
  }

  .screenshot-placeholder__mock-line--short {
    width: 42%;
  }

  .screenshot-placeholder__mock-line--medium {
    width: 72%;
  }

  .screenshot-placeholder__mock-card {
    display: grid;
    gap: 0.75rem;
    min-height: 7.5rem;
    margin-top: 0.55rem;
    padding: 1rem;
    border-radius: 1.25rem;
    background: var(--card);
    box-shadow:
      0.22rem 0.32rem 0 var(--card-back-1),
      0 0.55rem 0.9rem rgb(0 0 0 / 0.2);
  }

  .screenshot-placeholder__mock-card span {
    display: block;
    height: 0.62rem;
    border-radius: 999px;
    background: var(--secondary-text);
    opacity: 0.62;
  }

  .screenshot-placeholder__mock-card span:last-child {
    width: 64%;
  }

  .screenshot-placeholder__mock-button {
    height: 3.1rem;
    margin-top: 0.75rem;
    border-radius: 1rem;
    background: var(--button);
    box-shadow: 0.12rem 0.28rem 0 var(--button-back);
  }

  .screenshot-placeholder--sealed .screenshot-placeholder__mock-card {
    min-height: 9.75rem;
  }

  .screenshot-placeholder--sealed .screenshot-placeholder__mock-button {
    margin-top: 0.25rem;
  }

  .screenshot-placeholder--result .screenshot-placeholder__mock-card {
    border: 0.08rem solid rgb(150 184 214 / 0.24);
  }

  .screenshot-placeholder--result .screenshot-placeholder__mock-button {
    width: 68%;
    justify-self: center;
    background: var(--ring);
    box-shadow: 0.12rem 0.28rem 0 var(--card-back-2);
  }

  .screenshot-placeholder__badge {
    margin-top: auto;
    align-self: center;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: var(--forest-front);
    color: var(--secondary-text);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .screenshot-placeholder {
      width: min(74vw, 16rem);
    }
  }
</style>
